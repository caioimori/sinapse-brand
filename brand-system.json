{
  "schema_version": 1,
  "brand_id": "sinapse-si",
  "version": "5.0-proposal",
  "stage": "art_direction_for_review",
  "strategy": {
    "positioning": "Ecossistema de inteligência aplicada que conecta educação, software e crescimento.",
    "promise": "Inteligência para ampliar o que você consegue fazer.",
    "difference": "School desenvolve repertório, House constrói e Growth mantém a operação aprendendo.",
    "reasons_to_believe": [
      {
        "pillar": "School",
        "evidence": "O percurso público organiza fundamentos, prática orientada e projetos. A T04 tem lista de espera, mentoria em grupo e aulas gravadas.",
        "source": "https://sinapse.si/school"
      },
      {
        "pillar": "House",
        "evidence": "A página pública apresenta descoberta, experiência, desenvolvimento, validação e produção. Cada entrega depende do escopo contratado.",
        "source": "https://sinapse.si/house"
      },
      {
        "pillar": "Growth",
        "evidence": "A oferta pública apresenta especialistas, operação full time e agentes de automação e monitoramento. Resultados dependem do contexto e do trabalho realizado.",
        "source": "https://sinapse.si/growth"
      }
    ],
    "personality": [
      "precisa",
      "próxima",
      "confiante",
      "responsável"
    ],
    "principles": [
      {
        "title": "Capacidade ampliada.",
        "text": "A tecnologia importa quando amplia a capacidade de aprender, criar, decidir e executar. A demonstração deve chegar a uma entrega que as pessoas consigam usar."
      },
      {
        "title": "Clareza radical.",
        "text": "Um assunto por composição. Hierarquia antes de efeito. A pessoa deve entender o próximo passo sem precisar conhecer o nosso vocabulário técnico."
      },
      {
        "title": "Precisão humana.",
        "text": "Pessoas definem direção e assumem responsabilidade. Agentes ampliam a execução. A experiência real é o critério para revisar o resultado."
      },
      {
        "title": "Inteligência conectada.",
        "text": "School desenvolve repertório, House constrói soluções e Growth mantém a operação aprendendo. Os três braços podem se complementar sem confundir a contratação."
      }
    ]
  },
  "naming": {
    "display_name": "SINAPSE SI",
    "pronunciation": "Sinapse, seguido das letras S e I.",
    "domain": "sinapse.si",
    "handle": "@sinapse.si",
    "status": "user_defined",
    "architecture": {
      "model": "Marca principal com três braços descritores",
      "hierarchy": [
        "SINAPSE SI",
        "Sinapse School",
        "Sinapse House",
        "Sinapse Growth"
      ],
      "rationale": "Reconhecimento compartilhado e ofertas distintas."
    }
  },
