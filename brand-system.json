  "voice": {
    "point_of_view": "Ampliar a capacidade de aprender, criar, decidir e executar.",
    "traits": [
      "precisa",
      "próxima",
      "confiante"
    ],
    "vocabulary": [
      "aplicar",
      "conectar",
      "contexto",
      "repertório",
      "construir",
      "operação"
    ],
    "avoid": [
      "resultado garantido sem prova",
      "parceria inferida de uso de ferramenta",
      "matrícula por lista de espera"
    ],
    "examples": [
      {
        "context": "Institucional",
        "before": "Soluções disruptivas que revolucionam o futuro com IA.",
        "after": "Conectamos tecnologia, aprendizado e operação para ampliar o que você consegue fazer."
      },
      {
        "context": "School",
        "before": "Domine todas as IAs e nunca mais fique para trás.",
        "after": "Aprenda a dar contexto, testar possibilidades e aplicar IA aos seus projetos."
      },
      {
        "context": "House",
        "before": "Seu app pronto com um prompt.",
        "after": "Transformamos uma necessidade em um projeto com escopo, experiência e validação."
      },
      {
        "context": "Growth",
        "before": "Venda no automático com resultados garantidos.",
        "after": "Conecte estratégia, conteúdo, mídia e dados em uma operação que aprende a cada ciclo."
      },
      {
        "context": "Lista de espera",
        "before": "Garanta agora sua vaga na T04.",
        "after": "Entre na lista da T04 e receba os avisos da próxima turma."
      },
      {
        "context": "Suporte",
        "before": "Ocorreu uma falha inesperada. Error 502.",
        "after": "Não foi possível concluir agora. Seus dados continuam preenchidos; tente novamente em alguns instantes."
      }
    ],
    "claim_sources": [
