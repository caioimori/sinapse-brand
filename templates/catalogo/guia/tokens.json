{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Guia / Documentacao single-file (B&W SINAPSE). Reference: soier__claude-code-push-guide (unico 100% fiel B&W). HTML estatico, tokens :root inline, zero build. Default vanta-ish documento (bone/vanta nomeados). REMOVIDOS tokens mortos (--void #000, --success/--error nao usados) e o derrape teal #00D4AA do setup-guide.",
  "color": {
    "semantic": {
      "$type": "color",
      "$description": "Nomeacao semantica do guia (--vanta/--bone/--rule). Preto #0A0A0A na superficie real (rule 02).",
      "vanta": { "$value": "#0A0A0A", "$description": "fundo escuro do code-block invertido / superficie dark" },
      "bone": { "$value": "#F5F5F0", "$description": "off-white quente, fg/superficie clara" },
      "rule": { "$value": "rgba(10,10,10,0.10)", "$description": "borda hairline sobre bone" },
      "rule-strong": { "$value": "rgba(10,10,10,0.20)" },
      "muted": { "$value": "rgba(10,10,10,0.55)" },
      "page-energy": { "$value": "rgba(10,10,10,0.04)", "$description": "radial sutil de fundo do tema" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "display": { "$value": ["Sora", "system-ui", "sans-serif"] },
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "fontSize": {
      "$type": "dimension",
      "$description": "Hero clamp escapa a dead-zone. H2 28px (logo abaixo da faixa) — seguro. Step index 64px display.",
      "tag": { "$value": "11px", "$description": "tag pill mono com colchetes [ ]" },
      "body": { "$value": "15px" },
      "h2": { "$value": "28px", "$description": "abaixo da dead-zone, seguro" },
      "step-index": { "$value": "64px", "$description": "display Sora dos steps numerados" },
      "hero": { "$value": "clamp(4.5rem, 14vw, 11.25rem)", "$description": "72-180px — escapa a dead-zone" }
    },
    "fontWeight": { "light": { "$value": 300 }, "regular": { "$value": 400 }, "medium": { "$value": 500 } },
    "lineHeight": { "hero": { "$value": 0.92 }, "body": { "$value": 1.6 } },
    "letterSpacing": { "hero": { "$value": "-0.035em" }, "tag": { "$value": "0.18em" } }
  },
  "spacing": {
    "$type": "dimension",
    "page-padding": { "$value": "clamp(1.5rem, 4vw, 4rem)" }
  },
  "sizing": {
    "$type": "dimension",
    "frame": { "$value": "min(92vw, 1440px)", "$description": "chassi — substitui max-width:1280px hardcoded por largura fluida" }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": "8px" },
    "lg": { "$value": "10px" },
    "code": { "$value": "12px", "$description": "code-block invertido" }
  },
  "motion": {
    "easing": { "$type": "cubicBezier", "smooth": { "$value": [0.16, 1, 0.3, 1] } },
    "duration": { "$type": "duration", "base": { "$value": "250ms" } },
    "keyframes": { "$description": "fade sutil. prefers-reduced-motion honrado (rule 08)." }
  },
  "identityLayer": {
    "$description": "Fiel ao brandbook B&W.",
    "grain": { "$value": "SVG inline data-uri feTurbulence opacity .05 + mix-blend-mode multiply (rule 03/11)" },
    "crosshair": { "$value": "CSS-only (rule 11)" },
    "frame": { "$value": "bordas verticais + topbar/footer mono" },
    "steps": { "$value": "counter CSS auto-numerado" },
    "tag-pill": { "$value": "colchetes via ::before/::after" }
  }
}
