{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "SaaS App autenticado (shell + dashboard). Reference: caio__sinapse-crm. Default vanta (dark-first). MESMO token-set SINAPSE invertido. AppShell + dashboard block + estados de primeira classe. CORRIGIDO: headlines fora da dead-zone, sem token fantasma (--color-muted-foreground), ThemeProvider montado.",
  "color": {
    "primitive": {
      "$type": "color",
      "gray-50": { "$value": "#F5F5F0" },
      "gray-800": { "$value": "#1F1F1F" },
      "gray-850": { "$value": "#1A1A1A" },
      "gray-900": { "$value": "#141414" },
      "gray-950": { "$value": "#0A0A0A", "$description": "PRETO MINIMO. NUNCA #000." }
    },
    "semantic": {
      "$type": "color",
      "$description": "Vanta default. data-theme=bone inverte.",
      "background": { "$value": "{color.primitive.gray-950}" },
      "foreground": { "$value": "{color.primitive.gray-50}" },
      "card": { "$value": "{color.primitive.gray-900}" },
      "surface": { "$value": "{color.primitive.gray-850}", "$description": "card hover / superficie elevada" },
      "surface-2": { "$value": "{color.primitive.gray-850}" },
      "surface-3": { "$value": "{color.primitive.gray-800}" },
      "muted": { "$value": "rgba(245,245,240,0.55)", "$description": "ex-token-fantasma --color-muted-foreground: DEFINIDO aqui" },
      "border": { "$value": "rgba(245,245,240,0.10)" },
      "border-strong": { "$value": "rgba(245,245,240,0.20)" },
      "input": { "$value": "rgba(245,245,240,0.14)" },
      "ring": { "$value": "rgba(245,245,240,0.30)" },
      "subtle": { "$value": "rgba(245,245,240,0.08)" }
    },
    "status": {
      "$type": "color",
      "$description": "B&W por intensidade. ok/warn/critical = mesma cor, peso/opacity diferem. StatusPill data-driven por token map — nunca hardcode.",
      "ok": { "$value": "rgba(245,245,240,0.95)" },
      "warn": { "$value": "rgba(245,245,240,0.70)" },
      "critical": { "$value": "rgba(245,245,240,0.45)" },
      "destructive": { "$value": "#FF3A2D", "$description": "funcional isolado, fora do brand" },
      "success": { "$value": "#00C853", "$description": "funcional isolado, fora do brand" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "display": { "$value": ["Sora", "system-ui", "sans-serif"] },
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "fontSize": {
      "$type": "dimension",
      "$description": "CORRIGIDO: KPI value e page H1 empurrados pra fora da dead-zone 32-48px.",
      "meta": { "$value": "11px", "$description": "eyebrow mono, tracking 0.22em" },
      "body-sm": { "$value": "13px" },
      "body": { "$value": "15px" },
      "kpi-value": { "$value": "clamp(3rem, 4vw, 3.75rem)", "$description": "48-60px tabular-nums — FORA da dead-zone (era clamp 2-2.75rem=32-44px)" },
      "page-title": { "$value": "clamp(3rem, 5vw, 4rem)", "$description": "48-64px (empty/funnel H1 corrigidos)" },
      "hero": { "$value": "clamp(3.75rem, 11vw, 11rem)", "$description": "60-176px" }
    },
    "fontWeight": { "light": { "$value": 300 }, "regular": { "$value": 400 }, "medium": { "$value": 500 } },
    "lineHeight": { "display": { "$value": 0.92 }, "body": { "$value": 1.6 } },
    "letterSpacing": { "display": { "$value": "-0.035em" }, "eyebrow": { "$value": "0.22em" } }
  },
  "spacing": {
    "$type": "dimension",
    "container-padding": { "$value": "clamp(1.5rem, 4vw, 5rem)" }
  },
  "sizing": {
    "$type": "dimension",
    "sidebar": { "$value": "248px", "$description": "240-248px, colapsa 64-68px" },
    "sidebar-collapsed": { "$value": "64px" },
    "topbar": { "$value": "56px" },
    "container-default": { "$value": "min(92vw, 1680px)", "$description": "max-w-screen-2xl. Substitui max-w-[1680px]/[1280px] hardcoded das views." }
  },
  "radius": {
    "$type": "dimension",
    "$description": "HARD-CAP: radius >12px em cards de dashboard e anti-pattern.",
    "sm": { "$value": "6px" },
    "md": { "$value": "8px", "$description": "inputs" },
    "lg": { "$value": "10px", "$description": "buttons" },
    "xl": { "$value": "12px", "$description": "cards dashboard (cap 12px)" },
    "badge": { "$value": "9999px" }
  },
  "motion": {
    "easing": {
      "$type": "cubicBezier",
      "smooth": { "$value": [0.16, 1, 0.3, 1] },
      "apple": { "$value": [0.32, 0.72, 0, 1] },
      "swift": { "$value": [0.4, 0, 0.2, 1] }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "base": { "$value": "250ms" },
      "slow": { "$value": "400ms" }
    },
    "keyframes": { "$description": "reveal escalonado, statusPulse (status-dot), link-reveal underline, button active:scale(0.98), grainShift. reduced-motion honrado." }
  },
  "identityLayer": {
    "grain": { "$value": "SVG inline feTurbulence ~6% sempre ativo" },
    "pattern-grid": { "$value": "grid sutil no shell" }
  }
}
