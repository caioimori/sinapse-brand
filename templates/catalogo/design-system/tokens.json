{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "SINAPSE Design System / Brandbook — fonte da verdade B&W. Tokens canonicos extraidos de caio__sinapse-brand. Tema default: bone (light-first). Vanta (dark) por data-theme. Diferenciacao por INTENSIDADE/opacity, nunca por hue. Preto minimo #0A0A0A (rule 02). Accent cromatico PROIBIDO.",
  "color": {
    "primitive": {
      "$type": "color",
      "$description": "Grayscale 13-step. Diferenciacao por intensidade, nao por hue.",
      "gray-0": { "$value": "#FAFAF7", "$description": "card / surface mais clara (bone)" },
      "gray-50": { "$value": "#F5F5F0", "$description": "background bone / foreground vanta (off-white quente)" },
      "gray-100": { "$value": "#EFEFEB", "$description": "muted bone" },
      "gray-150": { "$value": "#EBEBE5" },
      "gray-300": { "$value": "#D4D4CE" },
      "gray-500": { "$value": "#999992" },
      "gray-600": { "$value": "#5C5C58" },
      "gray-700": { "$value": "#2E2E2B" },
      "gray-800": { "$value": "#1F1F1F", "$description": "surface-3 vanta" },
      "gray-850": { "$value": "#1A1A1A", "$description": "surface-2 vanta" },
      "gray-900": { "$value": "#141414", "$description": "card vanta" },
      "gray-950": { "$value": "#0A0A0A", "$description": "PRETO MINIMO (rule 02). NUNCA #000 puro como superficie." },
      "void": { "$value": "#000000", "$description": "PRIMITIVO DE MASCARA/CATALOGO APENAS. Banido como superficie/fundo (rule 02)." }
    },
    "semantic": {
      "$type": "color",
      "bone": {
        "$description": "Tema default (light-first). Brandbook, guias, LP.",
        "background": { "$value": "{color.primitive.gray-50}" },
        "foreground": { "$value": "{color.primitive.gray-950}" },
        "card": { "$value": "{color.primitive.gray-0}" },
        "muted": { "$value": "{color.primitive.gray-100}" },
        "border": { "$value": "rgba(10,10,10,0.10)" },
        "border-strong": { "$value": "rgba(10,10,10,0.20)" },
        "subtle": { "$value": "rgba(10,10,10,0.08)" },
        "ring": { "$value": "rgba(10,10,10,0.30)" }
      },
      "vanta": {
        "$description": "Tema dark (opt-in via data-theme). SaaS app/dashboard usam como default.",
        "background": { "$value": "{color.primitive.gray-950}" },
        "foreground": { "$value": "{color.primitive.gray-50}" },
        "card": { "$value": "{color.primitive.gray-900}" },
        "surface-2": { "$value": "{color.primitive.gray-850}" },
        "surface-3": { "$value": "{color.primitive.gray-800}" },
        "muted": { "$value": "rgba(245,245,240,0.55)" },
        "border": { "$value": "rgba(245,245,240,0.10)" },
        "border-strong": { "$value": "rgba(245,245,240,0.20)" },
        "subtle": { "$value": "rgba(245,245,240,0.08)" },
        "input": { "$value": "rgba(245,245,240,0.14)" },
        "ring": { "$value": "rgba(245,245,240,0.30)" }
      },
      "functional": {
        "$description": "FORA do brand. Isolados, nunca usados como accent decorativo. Estados padrao em B&W diferenciam por opacity/peso.",
        "destructive": { "$value": "#FF3A2D" },
        "success": { "$value": "#00C853" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "display": { "$value": ["Sora", "system-ui", "sans-serif"], "$description": "weights 300/400/500. Max 2 pesos/tela (rule 04)." },
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "body 400/500" },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "eyebrow/meta/kbd 400" }
    },
    "fontSize": {
      "$type": "dimension",
      "$description": "Escala 100% fluida com clamp(). Faixa 32-48px PROIBIDA em headlines (rule 05). Validas: 11-14px (meta) OU 60-180px (display).",
      "meta": { "$value": "10px", "$description": "labels/eyebrow mono" },
      "label": { "$value": "11px" },
      "body-sm": { "$value": "13px" },
      "body": { "$value": "15px" },
      "h2": { "$value": "clamp(3rem, 6vw, 4.5rem)", "$description": "48-72px — pula a dead-zone por construcao" },
      "h1": { "$value": "clamp(3.5rem, 8vw, 6.5rem)", "$description": "56-104px" },
      "display": { "$value": "clamp(3.75rem, 11vw, 11rem)", "$description": "60-176px — hero canonico" }
    },
    "fontWeight": {
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 }
    },
    "lineHeight": {
      "display": { "$value": 0.92 },
      "heading": { "$value": 1.05 },
      "body": { "$value": 1.6 }
    },
    "letterSpacing": {
      "display": { "$value": "-0.035em" },
      "eyebrow": { "$value": "0.22em", "$description": "uppercase, prefixo // ou colchetes" },
      "label": { "$value": "0.18em" }
    },
    "composite": {
      "$type": "typography",
      "eyebrow": {
        "$value": {
          "fontFamily": "{typography.fontFamily.mono}",
          "fontSize": "{typography.fontSize.label}",
          "fontWeight": "{typography.fontWeight.regular}",
          "letterSpacing": "{typography.letterSpacing.eyebrow}",
          "lineHeight": "1"
        }
      },
      "display": {
        "$value": {
          "fontFamily": "{typography.fontFamily.display}",
          "fontSize": "{typography.fontSize.display}",
          "fontWeight": "{typography.fontWeight.light}",
          "lineHeight": "{typography.lineHeight.display}",
          "letterSpacing": "{typography.letterSpacing.display}"
        }
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "Base 4-8px. NAO redefinir a escala Tailwind pra px absolutos (quebra h-9/gap-2 do shadcn).",
    "container-padding": { "$value": "clamp(1.5rem, 4vw, 5rem)" }
  },
  "sizing": {
    "$type": "dimension",
    "container-narrow": { "$value": "1024px" },
    "container-default": { "$value": "1440px" },
    "container-wide": { "$value": "min(92vw, 1680px)", "$description": "max-w-screen-2xl. NUNCA max-w-7xl hardcoded." }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Confirmado sinapse-brand/crm.",
    "sm": { "$value": "6px" },
    "md": { "$value": "8px", "$description": "inputs" },
    "lg": { "$value": "10px", "$description": "buttons (base)" },
    "xl": { "$value": "16px", "$description": "cards" },
    "2xl": { "$value": "20px", "$description": "modais" },
    "badge": { "$value": "9999px" }
  },
  "motion": {
    "easing": {
      "$type": "cubicBezier",
      "smooth": { "$value": [0.16, 1, 0.3, 1], "$description": "DEFAULT" },
      "apple": { "$value": [0.32, 0.72, 0, 1] },
      "back": { "$value": [0.34, 1.56, 0.64, 1], "$description": "overshoot" },
      "swift": { "$value": [0.4, 0, 0.2, 1] }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "base": { "$value": "250ms" },
      "slow": { "$value": "400ms", "$description": "cap ~500ms; 800ms+ e anti-pattern" }
    },
    "keyframes": {
      "$description": "fadeUp/reveal escalonado (reveal-delay-1..5 a 0.08s), grainShift 8s steps(10), statusPulse, link-reveal underline scaleX origin-flip, button active:scale(0.98). prefers-reduced-motion SEMPRE honrado (rule 08)."
    }
  },
  "identityLayer": {
    "$description": "min 2 camadas, nunca fundo liso (rule 03/11).",
    "grain": { "$value": "SVG inline data-uri feTurbulence ~5-6% sempre ativo" },
    "crosshair": { "$value": "CSS-only" },
    "frame": { "$value": "bordas verticais" }
  }
}
