{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Landing Page / Site Institucional. Reference: caio__sinapse-club. Default bone (light-first). MESMO token-set SINAPSE. Suite modular lp-* + SectionHeader canonico + CtaPill variant. CORRIGIDO: H2 de secao salta a dead-zone (era text-4xl=36px), CTA como variant nao string copiada 6x.",
  "color": {
    "primitive": {
      "$type": "color",
      "gray-0": { "$value": "#FAFAF7" },
      "gray-50": { "$value": "#F5F5F0" },
      "gray-100": { "$value": "#EFEFEB" },
      "gray-950": { "$value": "#0A0A0A", "$description": "PRETO MINIMO. NUNCA #000." }
    },
    "semantic": {
      "$type": "color",
      "$description": "Bone default. Vanta por data-theme.",
      "background": { "$value": "{color.primitive.gray-50}" },
      "foreground": { "$value": "{color.primitive.gray-950}" },
      "card": { "$value": "{color.primitive.gray-0}" },
      "muted": { "$value": "{color.primitive.gray-100}" },
      "border": { "$value": "rgba(10,10,10,0.10)" },
      "border-strong": { "$value": "rgba(10,10,10,0.20)" },
      "subtle": { "$value": "rgba(10,10,10,0.08)" },
      "ring": { "$value": "rgba(10,10,10,0.30)" },
      "overlay": { "$value": "rgba(10,10,10,0.55)", "$description": "scrim tokenizado — substitui os bg-black/10..60 espalhados" }
    },
    "functional": {
      "$type": "color",
      "destructive": { "$value": "#FF3A2D" },
      "success": { "$value": "#00C853" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "display": { "$value": ["Sora", "system-ui", "sans-serif"] },
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "fontSize": {
      "$type": "dimension",
      "$description": "CORRIGIDO: H2 de secao nunca cai em 36px no mobile. Salta direto pra >=48px.",
      "eyebrow": { "$value": "11px", "$description": "mono, tracking 0.22em, uppercase, // prefix" },
      "body": { "$value": "15px" },
      "lead": { "$value": "clamp(1.125rem, 2vw, 1.375rem)", "$description": "descricao de SectionHeader" },
      "h2": { "$value": "clamp(3rem, 6vw, 5rem)", "$description": "48-80px — pula a dead-zone (era text-4xl=36px base)" },
      "hero": { "$value": "clamp(3.5rem, 9vw, 8rem)", "$description": "56-128px (club hero ~84px ja respeitava)" }
    },
    "fontWeight": { "light": { "$value": 300 }, "regular": { "$value": 400 }, "medium": { "$value": 500 } },
    "lineHeight": { "display": { "$value": 0.95 }, "body": { "$value": 1.6 } },
    "letterSpacing": { "display": { "$value": "-0.03em" }, "eyebrow": { "$value": "0.22em" } }
  },
  "spacing": {
    "$type": "dimension",
    "container-padding": { "$value": "clamp(1.5rem, 4vw, 5rem)" },
    "section-y": { "$value": "clamp(5rem, 12vw, 10rem)", "$description": "ritmo vertical entre blocos lp-*" }
  },
  "sizing": {
    "$type": "dimension",
    "container-narrow": { "$value": "896px", "$description": "max-w-4xl (texto longo)" },
    "container-default": { "$value": "1152px", "$description": "max-w-6xl" },
    "container-wide": { "$value": "min(92vw, 1680px)", "$description": "NUNCA max-w-7xl" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Cards de LP/marketing podem ir a 16-24px.",
    "md": { "$value": "10px" },
    "lg": { "$value": "16px", "$description": "cards" },
    "xl": { "$value": "24px", "$description": "cards marketing grandes" },
    "pill": { "$value": "9999px", "$description": "CtaPill" }
  },
  "motion": {
    "easing": {
      "$type": "cubicBezier",
      "smooth": { "$value": [0.16, 1, 0.3, 1] },
      "craft": { "$value": [0.65, 0.05, 0, 1], "$description": "split-line reveal" },
      "back": { "$value": [0.34, 1.56, 0.64, 1] }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "base": { "$value": "250ms" },
      "slow": { "$value": "400ms" }
    },
    "keyframes": { "$description": "reveal on-scroll (data-reveal, UM mecanismo via IntersectionObserver), text-reveal blur+translate, fade-in-up escalonado, link-reveal underline scaleX. Smooth scroll (Lenis) opcional desktop-only. reduced-motion honrado." }
  },
  "components": {
    "ctaPill": {
      "$description": "VARIANT (nao string copiada 6x). bg-foreground text-background, pill, chip-seta group-hover:rotate-45, hover -translate-y-0.5.",
      "radius": "{radius.pill}",
      "background": "{color.semantic.foreground}",
      "foreground": "{color.semantic.background}"
    }
  },
  "identityLayer": {
    "grain": { "$value": "SVG inline feTurbulence ~5% — adicionar (club roda quase liso)" },
    "crosshair": { "$value": "CSS-only" }
  }
}
