{
  "$meta": {
    "name": "SINAPSE Design Canon v1",
    "anchor": "hub.snps.ai (Tailwind v4 + shadcn, validated at source 2026-06-18)",
    "structure": "core + official variants",
    "rule": "Every decision resolves to ONE core value. Variants deviate only where declared in 00-SINAPSE-CANON.md §6.",
    "spec": "00-SINAPSE-CANON.md"
  },
  "color": {
    "primitives": {
      "vanta": "#0A0A0A", "bone": "#F5F5F0", "void": "#000000",
      "gray-00": "#FFFFFF", "gray-05": "#FAFAFA", "gray-10": "#F5F5F0", "gray-15": "#EBEBE6",
      "gray-20": "#D4D4D0", "gray-30": "#A3A39F", "gray-40": "#737370", "gray-50": "#525250",
      "gray-60": "#404040", "gray-70": "#2A2A2A", "gray-80": "#1A1A1A", "gray-90": "#141414", "gray-100": "#0A0A0A"
    },
    "semantic": {
      "light": {
        "background": "#F5F5F0", "foreground": "#0A0A0A", "card": "#FFFFFF", "card-foreground": "#0A0A0A",
        "popover": "#FFFFFF", "primary": "#0A0A0A", "primary-foreground": "#F5F5F0",
        "secondary": "#EBEBE6", "muted": "#EBEBE6", "muted-foreground": "#525250", "accent": "#EBEBE6",
        "destructive": "#FF3A2D", "border": "rgba(10,10,10,0.10)", "input": "rgba(10,10,10,0.10)", "ring": "rgba(10,10,10,0.30)"
      },
      "dark": {
        "background": "#0A0A0A", "foreground": "#F5F5F0", "card": "#141414", "card-foreground": "#F5F5F0",
        "popover": "#141414", "primary": "#F5F5F0", "primary-foreground": "#0A0A0A",
        "secondary": "#1A1A1A", "muted": "#1A1A1A", "muted-foreground": "rgba(245,245,240,0.55)", "accent": "#1A1A1A",
        "destructive": "#FF3A2D", "border": "rgba(245,245,240,0.10)", "input": "rgba(245,245,240,0.10)", "ring": "rgba(245,245,240,0.30)"
      }
    },
    "chart": {
      "light": ["#0A0A0A", "#2A2A2A", "#525250", "#A3A39F", "#D4D4D0"],
      "dark": ["#F5F5F0", "#A3A39F", "#737370", "#525250", "#404040"]
    },
    "sidebar": {
      "light": { "sidebar": "#FAFAFA", "foreground": "#0A0A0A", "border": "rgba(10,10,10,0.10)" },
      "dark": { "sidebar": "#141414", "foreground": "#F5F5F0", "border": "rgba(245,245,240,0.10)" }
    },
    "functional": {
      "status": { "error": "#FF3A2D", "success": "#00C853", "warning": "#F59E0B", "info": "#3B82F6" },
      "platform_ads_only": { "meta": "#0866FF", "whatsapp": "#25D366", "google": "#4285F4" },
      "ads_channels": { "traffic": "#06B6D4", "engagement": "#EC4899", "awareness": "#8B5CF6", "app": "#6366F1" }
    }
  },
  "typography": {
    "families": { "display": "Sora", "sans": "Inter", "mono": "JetBrains Mono", "wordmark": "Audiowide" },
    "weights": [300, 400, 500, 600],
    "max_weights_per_screen": 2,
    "feature_settings": "\"cv01\",\"ss03\"",
    "global_letter_spacing": "-0.011em",
    "ui_scale_rem": { "xs": 0.75, "sm": 0.875, "base": 1, "lg": 1.125, "xl": 1.25, "2xl": 1.5, "3xl": 1.875, "4xl": 2.25, "5xl": 3 },
    "display_scale": {
      "hero": "clamp(3.75rem, 11vw, 11rem)",
      "xl": "clamp(2.75rem, 6vw, 5rem)",
      "lg": "clamp(3.25rem, 5vw, 4.5rem)"
    },
    "headline_dead_zone_forbidden_px": "32-48",
    "eyebrow": { "font": "mono", "transform": "uppercase", "tracking": "0.14em", "size_px": "11-13" },
    "headline_tracking": "-0.02em to -0.035em"
  },
  "radius": { "base": "6px", "sm": "4px", "md": "4px", "lg": "6px", "xl": "10px", "2xl": "14px", "xs": "0.125rem", "round": "1rem", "pill": "9999px" },
  "spacing": { "base": "0.25rem", "scale": "calc(base * n)" },
  "layout": {
    "containers_rem": { "xs": 20, "sm": 24, "md": 28, "lg": 32, "xl": 36, "2xl": 42, "3xl": 48, "5xl": 64, "6xl": 72 },
    "breakpoints_rem": { "sm": 40, "md": 48, "lg": 64, "xl": 80, "2xl": 96, "mobile_guard_px": 767 },
    "forbidden": "max-w-7xl raw"
  },
  "motion": {
    "default": "0.15s cubic-bezier(.4,0,.2,1)",
    "easings": { "out": "cubic-bezier(0,0,.2,1)", "in-out": "cubic-bezier(.4,0,.2,1)", "pulse": "cubic-bezier(.4,0,.6,1)" },
    "keyframes_core": ["spin", "pulse", "enter", "exit", "fadeUp"],
    "reduced_motion": "global override to 0.01ms"
  },
  "effects": {
    "shadows": {
      "xs": "0 1px 2px 0 #0000000d",
      "sm": "0 1px 3px 0 #0000001a, 0 1px 2px -1px #0000001a",
      "md": "0 4px 6px -1px #0000001a, 0 2px 4px -2px #0000001a",
      "lg": "0 10px 15px -3px #0000001a, 0 4px 6px -4px #0000001a",
      "2xl": "0 25px 50px -12px #00000040",
      "drawer": "8px 0 24px -12px rgba(0,0,0,0.6)"
    },
    "blur": { "sm": "8px", "md": "12px" },
    "focus_ring": "outline 2px solid transparent + color-mix(in oklab, var(--foreground) 40%, transparent)",
    "grain": { "selector": "body::before", "opacity": 0.05, "blend": "overlay", "z": 9999, "svg": "feTurbulence fractalNoise baseFrequency=0.85 numOctaves=2" },
    "club_glass": "backdrop-blur 12-20px + saturate(1.8) + inner-highlight (variant-only)"
  },
  "icons": { "lib": "lucide-react", "default_size": "16px", "stroke": 2 },
  "charts_lib": "recharts",
  "components_base": ["button", "card", "badge", "input", "select", "dialog", "table", "tabs", "avatar", "checkbox", "dropdown-menu", "popover", "sheet", "separator", "textarea", "label", "form", "sonner"],
  "variants": {
    "app-hub": { "theme": "dark-first", "texture": "grain", "wordmark": "Audiowide", "notes": "reference impl; ads chromatic exception; fix #000 body -> #0A0A0A" },
    "institucional": { "surfaces": ["snps.ai", "snps.ai/growth"], "theme": "dark", "deviation": ["Audiowide wordmark", "glass + apple shadows", "chrome gradients", "hero display top"], "fix": ["#000 -> #0A0A0A", "growth #FF6B5F -> #FF3A2D"] },
    "club": { "surface": "sinapse.club", "theme": "light-first forced", "deviation": ["glass signature", "functional color for social/gamification", "Inter heading (no Sora)", "ring instead of border"], "fix": ["#000000 -> #0A0A0A", "radius 0.625rem -> 6px"], "origin": "caioimori-design-system" },
    "educacional": { "surface": "snps.ai/educacional", "theme": "dark", "deviation": ["Geist / Geist Mono type stack", "orbit/chat/smoke motion", "glass + radial glows"], "pending": "keep Geist as official variant OR migrate to Sora/Inter (recommend keep)" }
  }
}
