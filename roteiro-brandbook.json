{
  "schema_version": 1,
  "brand_id": "sinapse-si",
  "format": {
    "presentation": {
      "width": 1920,
      "height": 1080,
      "native_information_text": true,
      "embedded_fonts": true
    },
    "website": "responsive",
    "slide_count": 60
  },
  "modules": [
    {
      "id": "contexto",
      "when": "projeto completo ou rebranding",
      "purpose": "Problema, diagnóstico, evidências, escopo e decisão"
    },
    {
      "id": "publico",
      "when": "estratégia em escopo",
      "purpose": "Públicos, situações, necessidades, barreiras e jornada"
    },
    {
      "id": "plataforma",
      "when": "estratégia em escopo",
      "purpose": "Posicionamento, promessa, diferenciação e provas"
    },
    {
      "id": "arquitetura",
      "when": "múltiplas ofertas, produtos, empresas ou públicos; ou mudança de relação entre eles, mesmo preservando nomes",
      "purpose": "Hierarquia, marca única, endosso, autonomia, sinais compartilhados e transição"
    },
    {
      "id": "naming",
      "when": "criar, mudar ou documentar nomes e grafias",
      "purpose": "Lógica, grafia, pronúncia, disponibilidade e uso digital"
    },
    {
      "id": "voz",
      "when": "comunicação em escopo",
      "purpose": "Narrativa factual, manifesto, voz e exemplos por contexto"
    },
    {
      "id": "direcao",
      "when": "identidade em escopo",
      "purpose": "Moodboard, racional e direção escolhida"
    },
    {
      "id": "assinatura",
      "when": "identidade em escopo",
      "purpose": "Mestres, versões, respiro, redução e usos inadequados"
    },
    {
      "id": "sistema",
      "when": "identidade em escopo",
      "purpose": "Cor, tipografia, grafismos, composição e materiais pertinentes"
    },
    {
      "id": "fotografia",
      "when": "imagem em escopo",
      "purpose": "Produto, pessoas, luz, cenas, referências e continuidade"
    },
    {
      "id": "aplicacoes",
      "when": "pontos de contato selecionados",
      "purpose": "Marca em contextos reais da categoria"
    },
    {
      "id": "produto-digital",
      "when": "marca de aplicativo, SaaS ou produto digital em escopo",
      "purpose": "Objeto da marca, primeiro valor, ícone/plataformas e passagem para tokens, estados e voz funcional"
    },
    {
      "id": "corporativa",
      "when": "marca corporativa, serviços B2B ou portfólio em escopo",
      "purpose": "Papéis de compra, ofertas, provas, linguagem institucional/comercial e governança"
    },
    {
      "id": "editorial",
      "when": "conteúdo em escopo",
      "purpose": "Famílias, templates, sequências, perfis, bio e exemplos"
    },
    {
      "id": "transicao",
      "when": "rebranding",
      "purpose": "Preservação, mudanças, prioridades, dependências e recuperação"
    },
    {
      "id": "producao",
      "when": "entrega de sistema",
      "purpose": "Fontes, licenças, exportações, critérios, versões e responsáveis"
    }
  ],
